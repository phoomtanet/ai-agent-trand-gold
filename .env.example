# ==========================================
# OpenRouter — LLM + Embedding
# ==========================================
OPENROUTER_API_KEY=        # ได้จาก openrouter.ai
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
EMBEDDING_MODEL=google/gemini-embedding-2-preview

# ==========================================
# MongoDB
# ==========================================
MONGODB_URI=mongodb://mongodb:27017   # Docker
# MONGODB_URI=mongodb://localhost:27017  # Local dev
MONGODB_DB=gold_analyzer

# ==========================================
# Telegram
# ==========================================
TELEGRAM_BOT_TOKEN=        # ได้จาก @BotFather
TELEGRAM_CHAT_ID=          # ID ของ chat/group ที่รับ alert (เช่น -1001234567890)
NOTIFY_NO_TRADE=false      # true = ส่งแจ้งเมื่อไม่มีจุดเข้าด้วย

# ==========================================
# Gold Analyzer — Data
# ==========================================
GOLD_TICKER=GC=F                # COMEX Gold Futures
ENABLE_MARKET_CONTEXT=true      # ดึง DXY/Bond/SPX/BTC/Oil ด้วย
FETCH_INTERVAL_SEC=60           # ดึงราคาทุกกี่วินาที

# ==========================================
# Gold Analyzer — Tuning
# ==========================================
SAFETY_SCORE_THRESHOLD=6        # warm-up: 6, stable: 7
CONFIDENCE_THRESHOLD=60         # warm-up: 60, stable: 70
MIN_RR_RATIO=1.0                # RR ต่ำกว่านี้ไม่ส่ง alert
EMBEDDING_LOOKBACK_DAYS=7       # โหลด embeddings กี่วันย้อนหลัง (max 30)
TOP_K_SIMILAR=3                 # จำนวน similar patterns ที่ดึงมา
